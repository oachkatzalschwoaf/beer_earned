<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <setting propertyKey="@Properties.drink" title="@Strings.SettingsDrink">
        <settingConfig type="list">
            <listEntry value="0">@Strings.DrinkMug</listEntry>
            <listEntry value="1">@Strings.DrinkPils</listEntry>
            <listEntry value="2">@Strings.DrinkWheat</listEntry>
            <listEntry value="3">@Strings.DrinkBottle</listEntry>
            <listEntry value="4">@Strings.DrinkStout</listEntry>
            <listEntry value="5">@Strings.DrinkCola</listEntry>
            <listEntry value="6">@Strings.DrinkSpezi</listEntry>
            <listEntry value="7">@Strings.DrinkHerbal</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.caloriesPerBeer" title="@Strings.SettingsCaloriesPerBeer">
        <settingConfig type="numeric" min="10" max="5000"/>
    </setting>
    <setting propertyKey="@Properties.background" title="@Strings.SettingsBackground">
        <settingConfig type="list">
            <listEntry value="0">@Strings.BgAuto</listEntry>
            <listEntry value="1">@Strings.BgBlack</listEntry>
            <listEntry value="2">@Strings.BgWhite</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.roundingMode" title="@Strings.SettingsRounding">
        <settingConfig type="list">
            <listEntry value="0">@Strings.RoundDown</listEntry>
            <listEntry value="1">@Strings.RoundNearest</listEntry>
            <listEntry value="2">@Strings.RoundUp</listEntry>
            <listEntry value="3">@Strings.RoundExact</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.alertPopup" title="@Strings.SettingsAlertPopup">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.alertVibrate" title="@Strings.SettingsAlertVibrate">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.alertTone" title="@Strings.SettingsAlertTone">
        <settingConfig type="boolean"/>
    </setting>
</settings>
